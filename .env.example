# Copy this file to ".env" and fill in your real values.
# Never share your .env file or commit it to a public GitHub repo.

# From your app's page in the Shopify Partner Dashboard:
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Your Postgres connection string. Render and Railway both hand you
# one automatically when you add their free Postgres addon — copy it
# here. For local testing, something like:
# postgresql://postgres:yourpassword@localhost:5432/decisionporter
DATABASE_URL=

# The public web address where you deploy this app, no trailing slash.
# Example: https://decisionporter-app.onrender.com
APP_URL=

# Encrypts every stored API key and access token. Generate ONE value
# and never change it after real stores connect (their saved keys
# would become unreadable). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# On Render: add it under your web service's Environment tab.
ENCRYPTION_KEY=

# Keep this "true" while testing so Shopify doesn't charge real money.
# Change to "false" only when you're ready to launch for real.
BILLING_TEST_MODE=true

PORT=3000

# How often the decision engine checks every shop (minutes, minimum 5).
CYCLE_MINUTES=15
# Set to "true" to stop the automatic checks (e.g. while testing locally).
DISABLE_SCHEDULER=false
# Days to keep the decision log and other personal data (minimum 31).
RETENTION_DAYS=90
# Days to keep the record of who accessed personal data (minimum 90).
ACCESS_LOG_RETENTION_DAYS=365
